<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" stylesheets="@../css/POS.css" styleClass="root-bg"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.project.tas_pbo.controller.CashierController">

    <!-- ===================== TOP BAR ===================== -->
    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="20">
            <padding><Insets top="8" right="16" bottom="8" left="16"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="🏪" styleClass="logo-icon"/>
                <Label text="SISTEM POS" styleClass="brand-title"/>
                <Label styleClass="brand-version"/>
            </HBox>

            <Label text="|" styleClass="topbar-sep"/>
            <Label text="Toko Kelontong" styleClass="store-name"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="kasirLabel" text="Kasir:" styleClass="topbar-info"/>
            <Label text="|" styleClass="topbar-sep"/>
            <Label fx:id="dateTimeLabel" text="Senin, 15 Januari 2024, 10:30 WIB" styleClass="topbar-info"/>
        </HBox>
    </top>

    <!-- ===================== CENTER ===================== -->
    <center>
        <HBox spacing="14">
            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>

            <!-- LEFT: Cart Table + Search + Function Buttons -->
            <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="panel">
                <Label text="DAFTAR BELANJA" styleClass="panel-title"/>

                <TableView fx:id="cartTable" VBox.vgrow="ALWAYS" styleClass="cart-table">
                    <columns>
                        <TableColumn fx:id="colNo" text="NO" prefWidth="40"/>
                        <TableColumn fx:id="colBarcode" text="BARCODE" prefWidth="140"/>
                        <TableColumn fx:id="colNama" text="NAMA PRODUK" prefWidth="260"/>
                        <TableColumn fx:id="colQty" text="QTY" prefWidth="70"/>
                        <TableColumn fx:id="colSatuan" text="SATUAN" prefWidth="80"/>
                        <TableColumn fx:id="colTotal" text="TOTAL" prefWidth="110"/>
                    </columns>
                </TableView>

                <!-- Search bar -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField" promptText="Pencarian Produk / Scan Barcode (F2)"
                               styleClass="search-field" HBox.hgrow="ALWAYS"/>
                    <Button text="🔍" styleClass="search-btn"/>
                </HBox>

                <!-- Function buttons row -->
                <HBox spacing="6" alignment="CENTER">
                    <Button text="BAYAR&#10;F1" styleClass="func-btn, func-btn-pay" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="SCAN BARCODE&#10;F2" styleClass="func-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="EDIT QTY&#10;F3" styleClass="func-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="HAPUS ITEM&#10;F4" styleClass="func-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="CEK MEMBER&#10;F5" styleClass="func-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="CEK HARGA&#10;F6" styleClass="func-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="PENDING&#10;F7" styleClass="func-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="CETAK STRUK&#10;F8" styleClass="func-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="DISKON&#10;F9" styleClass="func-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
            </VBox>

            <!-- RIGHT: Total / Payment Panel -->
            <VBox spacing="10" prefWidth="380" styleClass="panel, total-panel">

                <!-- Total Belanja box -->
                <VBox styleClass="total-box" alignment="CENTER" spacing="4">
                    <Label text="TOTAL BELANJA (Rp)" styleClass="total-box-label"/>
                    <Label fx:id="grandTotalLabel" text="0" styleClass="total-box-value"/>
                </VBox>

                <!-- Subtotal / Diskon / Total Tagihan -->
                <GridPane hgap="10" vgap="10" styleClass="summary-grid">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <Label text="Subtotal" styleClass="summary-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="subtotalLabel" text="0" styleClass="summary-value"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Diskon/Promo" styleClass="summary-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="discountField" styleClass="discount-field"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Total Tagihan" styleClass="summary-label-bold" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="totalTagihanLabel" text="0" styleClass="summary-value-bold"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>

                <!-- Payment method buttons -->
                <GridPane hgap="8" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                    </columnConstraints>

                    <Button text="💵&#10;Tunai" styleClass="pay-method-btn, pay-method-active" maxWidth="Infinity"
                            GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Button text="💳&#10;Debit" styleClass="pay-method-btn" maxWidth="Infinity"
                            GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Button text="🔳&#10;QRIS" styleClass="pay-method-btn" maxWidth="Infinity"
                            GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <Button text="📱&#10;e-Wallet" styleClass="pay-method-btn" maxWidth="Infinity"
                            GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                </GridPane>

                <!-- Amount paid field -->
                <HBox spacing="8" alignment="CENTER">
                    <TextField fx:id="payField" styleClass="pay-field" HBox.hgrow="ALWAYS"/>
                    <Button text="⌫" styleClass="backspace-btn"/>
                </HBox>

                <!-- Numpad -->
                <GridPane hgap="8" vgap="8" VBox.vgrow="ALWAYS">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints percentHeight="33.3"/>
                        <RowConstraints percentHeight="33.3"/>
                        <RowConstraints percentHeight="33.3"/>
                    </rowConstraints>

                    <Button text="4" styleClass="num-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Button text="5" styleClass="num-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Button text="6" styleClass="num-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <Button text="×" styleClass="num-btn, num-btn-op" maxWidth="Infinity" maxHeight="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                    <Button text="1" styleClass="num-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Button text="2" styleClass="num-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Button text="3" styleClass="num-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <Button text="−" styleClass="num-btn, num-btn-op" maxWidth="Infinity" maxHeight="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                    <Button text="0" styleClass="num-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Button text="." styleClass="num-btn" maxWidth="Infinity" maxHeight="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Button fx:id="bayarButton" text="BAYAR" styleClass="bayar-btn" maxWidth="Infinity" maxHeight="Infinity"
                            GridPane.rowIndex="2" GridPane.columnIndex="2" GridPane.columnSpan="2"/>
                </GridPane>

            </VBox>
        </HBox>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="768.0" prefWidth="1200.0" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.project.tas_pbo.controller.DashboardManagerController">
    <left>
        <VBox prefWidth="250.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="15.0" styleClass="sidebar-header">
                    <children>
                        <Label text="🏪" textFill="WHITE">
                            <font><Font size="28.0" /></font>
                        </Label>
                        <VBox alignment="CENTER_LEFT">
                            <children>
                                <Label styleClass="logo-text" text="Toko Kelontong" />
                                <Label styleClass="logo-subtext" text="Sistem Penjualan" />
                            </children>
                        </VBox>
                    </children>
                    <padding><Insets left="20.0" /></padding>
                </HBox>

                <VBox spacing="5.0" styleClass="nav-menu" VBox.vgrow="ALWAYS">
                    <children>
                        <Button fx:id="btnDashboard" alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="45.0" prefWidth="250.0" styleClass="nav-btn-active" text="Dashboard" onAction="#showDashboardView">
                            <padding><Insets left="30.0" /></padding>
                        </Button>
                        <Button fx:id="btnPenjualan" alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="45.0" prefWidth="250.0" styleClass="nav-btn" text="Penjualan" onAction="#showPenjualanView">
                            <padding><Insets left="30.0" /></padding>
                        </Button>
                        <Button fx:id="btnProduk" alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="45.0" prefWidth="250.0" styleClass="nav-btn" text="Produk" onAction="#showProdukView">
                            <padding><Insets left="30.0" /></padding>
                        </Button>
                        <Button fx:id="btnLaporan" alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="45.0" prefWidth="250.0" styleClass="nav-btn" text="Laporan" onAction="#showLaporanView">
                            <padding><Insets left="30.0" /></padding>
                        </Button>
                        <Button fx:id="btnUser" alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="45.0" prefWidth="250.0" styleClass="nav-btn" text="Pengguna" onAction="#showUserView">
                            <padding><Insets left="30.0" /></padding>
                        </Button>
                    </children>
                    <VBox.margin><Insets top="20.0" /></VBox.margin>
                </VBox>

                <VBox>
                    <children>
                        <Button alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="45.0" prefWidth="250.0" styleClass="nav-btn" onAction="#handleLogin" text="Logout">
                            <padding><Insets left="30.0" /></padding>
                        </Button>
                        <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="15.0" styleClass="user-profile">
                            <children>
                                <Circle fill="#e0e0e0" radius="20.0" stroke="TRANSPARENT" strokeType="INSIDE" />
                                <VBox alignment="CENTER_LEFT">
                                    <children>
                                                <Label fx:id="lblUserName" styleClass="user-name" text="Manager" />
                                                        <Label fx:id="lblUserRole" styleClass="user-role" text="Manager" />
                                    </children>
                                </VBox>
                            </children>
                            <padding><Insets left="20.0" /></padding>
                            <VBox.margin><Insets top="10.0" /></VBox.margin>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" BorderPane.alignment="CENTER">
            <children>

                <!-- ================= DASHBOARD VIEW ================= -->
                <ScrollPane fx:id="dashboardView" fitToWidth="true" styleClass="main-scroll" visible="true" managed="true">
                    <content>
                        <VBox prefWidth="900.0" spacing="20.0" styleClass="main-content-bg">
                            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="20.0" /></padding>
                            <children>

                                <HBox alignment="CENTER_LEFT" prefHeight="50.0">
                                    <children>
                                        <Label styleClass="header-title" text="☰   Dashboard" />
                                        <Label fx:id="lblGreeting" styleClass="header-subtitle" text="Selamat datang, Manager!">
                                            <HBox.margin><Insets left="15.0" /></HBox.margin>
                                        </Label>
                                        <Pane HBox.hgrow="ALWAYS" />
                                        <HBox alignment="CENTER_RIGHT" spacing="20.0">
                                            <children>
                                                <Label fx:id="dateLabel" styleClass="header-time" text="📅 24 Mei 2024" />
                                                <Label fx:id="timeLabel" styleClass="header-time" text="⏱ 10:30:45" />
                                            </children>
                                        </HBox>
                                    </children>
                                </HBox>

                                <!-- Summary cards -->
                                <HBox spacing="20.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" prefHeight="100.0" spacing="15.0" styleClass="summary-card" HBox.hgrow="ALWAYS">
                                            <children>
                                                <StackPane prefHeight="60.0" prefWidth="60.0" style="-fx-background-color: #3b82f6; -fx-background-radius: 10;">
                                                    <children><Label text="🛒" textFill="WHITE"><font><Font size="28.0" /></font></Label></children>
                                                </StackPane>
                                                <VBox alignment="CENTER_LEFT" spacing="5.0">
                                                    <children>
                                                        <Label styleClass="card-title" text="Total Penjualan" />
                                                        <Label fx:id="lblTotalPenjualan" styleClass="card-value" text="Rp 0" />
                                                        <Label styleClass="card-subtitle-green" text="Hari ini  ↑ 12%" />
                                                    </children>
                                                </VBox>
                                            </children>
                                            <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
                                        </HBox>

                                        <HBox alignment="CENTER_LEFT" prefHeight="100.0" spacing="15.0" styleClass="summary-card" HBox.hgrow="ALWAYS">
                                            <children>
                                                <StackPane prefHeight="60.0" prefWidth="60.0" style="-fx-background-color: #22c55e; -fx-background-radius: 10;">
                                                    <children><Label text="📦" textFill="WHITE"><font><Font size="28.0" /></font></Label></children>
                                                </StackPane>
                                                <VBox alignment="CENTER_LEFT" spacing="5.0">
                                                    <children>
                                                        <Label styleClass="card-title" text="Total Produk" />
                                                        <Label fx:id="lblTotalProduk" styleClass="card-value" text="0" />
                                                        <Label styleClass="card-subtitle" text="Semua Produk" />
                                                    </children>
                                                </VBox>
                                            </children>
                                            <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
                                        </HBox>

                                        <HBox alignment="CENTER_LEFT" prefHeight="100.0" spacing="15.0" styleClass="summary-card" HBox.hgrow="ALWAYS">
                                            <children>
                                                <StackPane prefHeight="60.0" prefWidth="60.0" style="-fx-background-color: #f59e0b; -fx-background-radius: 10;">
                                                    <children><Label text="🧊" textFill="WHITE"><font><Font size="28.0" /></font></Label></children>
                                                </StackPane>
                                                <VBox alignment="CENTER_LEFT" spacing="5.0">
                                                    <children>
                                                        <Label styleClass="card-title" text="Total Stok" />
                                                        <Label fx:id="lblTotalStok" styleClass="card-value" text="0" />
                                                        <Label styleClass="card-subtitle" text="Semua Stok" />
                                                    </children>
                                                </VBox>
                                            </children>
                                            <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
                                        </HBox>

                                    </children>
                                </HBox>

                                <!-- Chart + Stok Menipis -->
                                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <VBox styleClass="content-box" HBox.hgrow="ALWAYS">
                                            <children>
                                                <!-- Chart header with filter buttons -->
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label styleClass="section-title" text="Grafik Penjualan" />
                                                        <Pane HBox.hgrow="ALWAYS" />
                                                        <Button fx:id="btnChart7Hari" text="7 Hari"
                                                                styleClass="btn-link"
                                                                onAction="#handleChart7Hari"
                                                                style="-fx-font-weight: bold;"/>
                                                        <Button fx:id="btnChart1Bulan" text="1 Bulan"
                                                                styleClass="btn-link"
                                                                onAction="#handleChart1Bulan"/>
                                                    </children>
                                                    <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                                                </HBox>

                                                <AreaChart fx:id="salesChart" prefHeight="250.0" animated="false">
                                                    <xAxis><CategoryAxis side="BOTTOM" /></xAxis>
                                                    <yAxis><NumberAxis side="LEFT" /></yAxis>
                                                </AreaChart>
                                            </children>
                                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                        </VBox>

                                        <VBox prefWidth="380.0" styleClass="content-box">
                                            <children>
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label styleClass="section-title" text="Stok Produk Menipis" />
                                                        <Pane HBox.hgrow="ALWAYS" />
<!--                                                        <Button styleClass="btn-link" text="Lihat Semua" onAction="#showStokView" />-->
                                                    </children>
                                                    <VBox.margin><Insets bottom="15.0" /></VBox.margin>
                                                </HBox>
                                                <TableView fx:id="tableStok" prefHeight="250.0" VBox.vgrow="ALWAYS">
                                                    <columns>
                                                        <TableColumn fx:id="colStokNo" prefWidth="40.0" text="No" />
                                                        <TableColumn fx:id="colStokNama" prefWidth="130.0" text="Produk" />
                                                        <TableColumn fx:id="colStokQty" prefWidth="50.0" text="Stok" />
                                                        <TableColumn fx:id="colStokSatuan" prefWidth="70.0" text="Satuan" />
                                                        <TableColumn fx:id="colStokStatus" prefWidth="70.0" text="Status" />
                                                    </columns>
                                                    <columnResizePolicy>
                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                    </columnResizePolicy>
                                                </TableView>
                                            </children>
                                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- Penjualan Terakhir + Produk Terlaris -->
                                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <VBox styleClass="content-box" HBox.hgrow="ALWAYS">
                                            <children>
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label styleClass="section-title" text="Penjualan Terakhir" />
                                                        <Pane HBox.hgrow="ALWAYS" />
                                                        <Button styleClass="btn-link" text="Lihat Semua" onAction="#showPenjualanView" />
                                                    </children>
                                                    <VBox.margin><Insets bottom="15.0" /></VBox.margin>
                                                </HBox>
                                                <TableView fx:id="tablePenjualan" prefHeight="200.0" VBox.vgrow="ALWAYS">
                                                    <columns>
                                                        <TableColumn fx:id="colPenjualanNo" prefWidth="40.0" text="No" />
                                                        <TableColumn fx:id="colPenjualanNoTrx" prefWidth="120.0" text="No. Transaksi" />
                                                        <TableColumn fx:id="colPenjualanTotal" prefWidth="100.0" text="Total" />
                                                        <TableColumn fx:id="colPenjualanWaktu" prefWidth="120.0" text="Waktu" />
                                                    </columns>
                                                    <columnResizePolicy>
                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                    </columnResizePolicy>
                                                </TableView>
                                            </children>
                                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                        </VBox>

                                        <VBox prefWidth="380.0" styleClass="content-box">
                                            <children>
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label styleClass="section-title" text="Produk Terlaris" />
                                                        <Pane HBox.hgrow="ALWAYS" />
                                                        <Button styleClass="btn-link" text="Lihat Semua" onAction="#showProdukView" />
                                                    </children>
                                                    <VBox.margin><Insets bottom="15.0" /></VBox.margin>
                                                </HBox>
                                                <TableView fx:id="tableTerlaris" prefHeight="200.0" VBox.vgrow="ALWAYS">
                                                    <columns>
                                                        <TableColumn fx:id="colTerlarisNo" prefWidth="40.0" text="No" />
                                                        <TableColumn fx:id="colTerlarisNama" prefWidth="150.0" text="Produk" />
                                                        <TableColumn fx:id="colTerlarisJumlah" prefWidth="80.0" text="Terjual" />
                                                        <TableColumn fx:id="colTerlarisSatuan" prefWidth="70.0" text="Satuan" />
                                                    </columns>
                                                    <columnResizePolicy>
                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                    </columnResizePolicy>
                                                </TableView>
                                            </children>
                                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                        </VBox>
                                    </children>
                                </HBox>

                            </children>
                        </VBox>
                    </content>
                </ScrollPane>

                <!-- ================= PENJUALAN VIEW ================= -->
                <VBox fx:id="penjualanView" visible="false" managed="false" spacing="20.0" styleClass="main-content-bg">
                    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="20.0" /></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="50.0">
                            <children>
                                <Label styleClass="header-title" text="☰   Penjualan" />
                                <Pane HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                        <VBox styleClass="content-box" VBox.vgrow="ALWAYS">
                            <children>
                                <Label styleClass="section-title" text="Daftar Penjualan" />
                                <TableView fx:id="tablePenjualanAll" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colPenjualanAllNo" prefWidth="40.0" text="No" />
                                        <TableColumn fx:id="colPenjualanAllNoTrx" prefWidth="120.0" text="No. Transaksi" />
                                        <TableColumn fx:id="colPenjualanAllTotal" prefWidth="100.0" text="Total" />
                                        <TableColumn fx:id="colPenjualanAllWaktu" prefWidth="120.0" text="Waktu" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                        </VBox>
                    </children>
                </VBox>

                <!-- ================= PRODUK VIEW ================= -->
                <VBox fx:id="produkView" visible="false" managed="false" spacing="20.0" styleClass="main-content-bg">
                    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="20.0" /></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="50.0">
                            <children>
                                <Label styleClass="header-title" text="☰   Produk" />
                                <Pane HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <children>
                                <TextField fx:id="searchProdukField" promptText="Cari produk..." HBox.hgrow="ALWAYS" />
                                <ComboBox fx:id="categoryFilter" prefWidth="180.0" promptText="Semua Kategori" />
                                <Button text="🔍 Cari" onAction="#handleSearchProduk" />
                            </children>
                        </HBox>
                        <VBox styleClass="content-box" VBox.vgrow="ALWAYS">
                            <children>
                                <Label styleClass="section-title" text="Daftar Produk" />
                                <TableView fx:id="tableProduk" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colNo" prefWidth="40.0" text="No" />
                                        <TableColumn fx:id="colNamaProduk" prefWidth="200.0" text="Nama Produk" />
                                        <TableColumn fx:id="colKategori" prefWidth="120.0" text="Kategori" />
                                        <TableColumn fx:id="colHarga" prefWidth="100.0" text="Harga" />
                                        <TableColumn fx:id="colStok" prefWidth="80.0" text="Stok" />
                                        <TableColumn fx:id="colSatuan" prefWidth="80.0" text="Satuan" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                                <HBox alignment="CENTER" spacing="20.0">
                                    <padding><Insets top="10.0" bottom="10.0" /></padding>
                                    <children>
                                        <Button fx:id="btnPrevProduk" text="◀ Sebelumnya" styleClass="btn-link" onAction="#prevPageProduk" disable="true" />
                                        <Label fx:id="lblPageProduk" text="Halaman 1 dari 1" styleClass="card-title" />
                                        <Button fx:id="btnNextProduk" text="Selanjutnya ▶" styleClass="btn-link" onAction="#nextPageProduk" />
                                    </children>
                                </HBox>
                            </children>
                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                        </VBox>
                    </children>
                </VBox>

                <!-- ================= STOK VIEW ================= -->
                <VBox fx:id="stokView" visible="false" managed="false" spacing="20.0" styleClass="main-content-bg">
                    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="20.0" /></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="50.0">
                            <children>
                                <Label styleClass="header-title" text="☰   Stok" />
                                <Pane HBox.hgrow="ALWAYS" />
                                <Button styleClass="btn-link" text="+ Input Stok" />
                            </children>
                        </HBox>
                        <VBox styleClass="content-box" VBox.vgrow="ALWAYS">
                            <children>
                                <Label styleClass="section-title" text="Data Stok Produk" />
                                <TableView fx:id="tableStokAll" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn prefWidth="40.0" text="No" />
                                        <TableColumn prefWidth="200.0" text="Produk" />
                                        <TableColumn prefWidth="100.0" text="Stok" />
                                        <TableColumn prefWidth="100.0" text="Satuan" />
                                        <TableColumn prefWidth="100.0" text="Status" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                        </VBox>
                    </children>
                </VBox>

                <!-- ================= USER VIEW ================= -->
                <VBox fx:id="userView" visible="false" managed="false" spacing="20.0" styleClass="main-content-bg">
                    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="20.0" /></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="50.0">
                            <children>
                                <Label styleClass="header-title" text="☰   Pengguna" />
                                <Pane HBox.hgrow="ALWAYS" />
                                <Button styleClass="btn-link" text="+ Tambah Pengguna" onAction="#handleTambahUser" />
                            </children>
                        </HBox>

                        <!-- Filter buttons -->
                        <HBox spacing="10.0">
                            <children>
                                <Button fx:id="btnFilterActiveUser" text="Semua Pengguna" styleClass="btn-link"
                                        style="-fx-font-weight: bold;" onAction="#showFilterActiveUser"/>
                                <Button fx:id="btnFilterDeletedUser" text="User Dihapus" styleClass="btn-link"
                                        onAction="#showFilterDeletedUser"/>
                            </children>
                        </HBox>

                        <!-- ===== ACTIVE USER SECTION ===== -->
                        <VBox fx:id="activeUserSection" visible="true" managed="true">
                            <children>
                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                    <children>
                                        <TextField fx:id="searchUserField" promptText="Cari pengguna..." HBox.hgrow="ALWAYS" />
                                        <Button text="🔍 Cari" onAction="#handleSearchUser" />
                                    </children>
                                </HBox>
                                <VBox styleClass="content-box" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="section-title" text="Daftar Pengguna" />
                                        <TableView fx:id="tableUser" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colUserNo" prefWidth="40.0" text="No" />
                                                <TableColumn fx:id="colUserUsername" prefWidth="130.0" text="Username" />
                                                <TableColumn fx:id="colUserNama" prefWidth="180.0" text="Nama Lengkap" />
                                                <TableColumn fx:id="colUserRole" prefWidth="100.0" text="Role" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                        <HBox spacing="10.0">
                                            <padding><Insets top="10.0" /></padding>
                                            <children>
                                                <Button text="✏️ Edit Pengguna" styleClass="btn-link" onAction="#handleEditUser" />
                                                <Button text="🔑 Ganti Password" styleClass="btn-link" onAction="#handleGantiPasswordUser" />
                                                <Button text="🗑️ Hapus Pengguna" styleClass="btn-link" onAction="#handleHapusUser" />
                                            </children>
                                        </HBox>
                                    </children>
                                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- ===== DELETED USER SECTION ===== -->
                        <VBox fx:id="deletedUserSection" visible="false" managed="false">
                            <children>
                                <VBox styleClass="content-box" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="section-title" text="Daftar Pengguna yang Dihapus" />
                                        <TableView fx:id="tableDeletedUser" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colDltUserNo" prefWidth="40.0" text="No" />
                                                <TableColumn fx:id="colDltUserUsername" prefWidth="130.0" text="Username" />
                                                <TableColumn fx:id="colDltUserNama" prefWidth="180.0" text="Nama Lengkap" />
                                                <TableColumn fx:id="colDltUserRole" prefWidth="100.0" text="Role" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                        <HBox spacing="10.0">
                                            <padding><Insets top="10.0" /></padding>
                                            <children>
                                                <Button text="🔁 Pulihkan Pengguna" styleClass="btn-link" onAction="#handlePulihkanUser" />
                                            </children>
                                        </HBox>
                                    </children>
                                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- ================= LAPORAN VIEW ================= -->
                <ScrollPane fx:id="laporanView" fitToWidth="true" visible="false" managed="false">
                    <content>
                        <VBox prefWidth="900.0" spacing="20.0" styleClass="main-content-bg">
                            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="20.0" /></padding>
                            <children>

                                <!-- Header + action buttons -->
                                <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="10.0">
                                    <children>
                                        <Label styleClass="header-title" text="☰   Laporan Keuangan" />
                                        <Pane HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnLaporan7Hari" text="7 Hari"
                                                styleClass="btn-link"
                                                onAction="#handleLaporan7Hari"
                                                style="-fx-font-weight: bold;"/>
                                        <Button fx:id="btnLaporan1Bulan" text="1 Bulan"
                                                styleClass="btn-link"
                                                onAction="#handleLaporan1Bulan"/>
                                        <Button text="👁 Preview"
                                                styleClass="btn-link"
                                                onAction="#handlePreviewLaporan"/>

                                        <Button text="💾 Simpan PDF"
                                                styleClass="btn-link"
                                                onAction="#handleSimpanPdf"/>
                                    </children>
                                </HBox>

                                <!-- Summary cards -->
                                <HBox spacing="20.0">
                                    <children>
                                        <VBox alignment="CENTER" spacing="5.0" styleClass="summary-card" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="card-title" text="Total Transaksi" />
                                                <Label fx:id="lblTotalTransaksi" styleClass="card-value" text="0" />
                                            </children>
                                            <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
                                        </VBox>
                                        <VBox alignment="CENTER" spacing="5.0" styleClass="summary-card" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="card-title" text="Total Penjualan" />
                                                <Label fx:id="lblTotalPenjualanLaporan" styleClass="card-value" text="Rp 0" />
                                            </children>
                                            <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
                                        </VBox>
                                        <VBox alignment="CENTER" spacing="5.0" styleClass="summary-card" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="card-title" text="Rata-rata/Hari" />
                                                <Label fx:id="lblRataRata" styleClass="card-value" text="Rp 0" />
                                            </children>
                                            <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- Laporan Chart -->
                                <VBox styleClass="content-box">
                                    <children>
                                        <Label styleClass="section-title" text="Grafik Penjualan Harian" />
                                                <AreaChart fx:id="laporanChart" prefHeight="280.0" animated="false">
                                            <xAxis><CategoryAxis side="BOTTOM" /></xAxis>
                                            <yAxis><NumberAxis side="LEFT" /></yAxis>
                                        </AreaChart>
                                    </children>
                                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                </VBox>

                                <!-- Detail table -->
                                <VBox styleClass="content-box" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="section-title" text="Detail Penjualan Harian" />
                                        <TableView fx:id="tableLaporan" VBox.vgrow="ALWAYS" prefHeight="250.0">
                                            <columns>
                                                <TableColumn fx:id="colLaporanTanggal" prefWidth="200.0" text="Tanggal" />
                                                <TableColumn fx:id="colLaporanTransaksi" prefWidth="150.0" text="Jumlah Transaksi" />
                                                <TableColumn fx:id="colLaporanTotal" prefWidth="200.0" text="Total Penjualan" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                </VBox>

                            </children>
                        </VBox>
                    </content>
                </ScrollPane>

                <!-- ================= PENGATURAN VIEW ================= -->
                <VBox fx:id="pengaturanView" visible="false" managed="false" spacing="20.0" styleClass="main-content-bg">
                    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="20.0" /></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="50.0">
                            <children>
                                <Label styleClass="header-title" text="☰   Pengaturan" />
                            </children>
                        </HBox>
                        <VBox styleClass="content-box" VBox.vgrow="ALWAYS">
                            <children>
                                <Label styleClass="section-title" text="Pengaturan Sistem" />
                                <Label text="Konten pengaturan akan ditampilkan di sini." />
                            </children>
                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                        </VBox>
                    </children>
                </VBox>

            </children>
        </StackPane>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768.0" prefWidth="1200.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.project.tas_pbo.controller.AdminDashboardController">

    <center>
        <VBox alignment="CENTER" spacing="20">
            <padding><Insets top="50" right="50" bottom="50" left="50"/></padding>
            <children>
                <Label text="🛠️" style="-fx-font-size: 64px;"/>
                <Label text="Admin Dashboard" style="-fx-font-size: 32px; -fx-font-weight: bold;"/>
                <Label fx:id="welcomeLabel" text="Selamat datang, Admin!"
                       style="-fx-font-size: 16px; -fx-text-fill: gray;"/>
                <Label text="Halaman ini sedang dalam pembangunan."
                       style="-fx-font-size: 14px; -fx-text-fill: gray;"/>
            </children>
        </VBox>
    </center>
</BorderPane>

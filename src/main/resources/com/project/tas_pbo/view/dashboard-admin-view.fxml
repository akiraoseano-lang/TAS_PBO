<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="768.0" prefWidth="1200.0"
            stylesheets="@../css/dashboard.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.project.tas_pbo.controller.AdminDashboardController">

    <!-- ===================== SIDEBAR ===================== -->
    <left>
        <VBox prefWidth="250.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <children>
                <!-- Logo -->
                <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="15.0" styleClass="sidebar-header">
                    <children>
                        <Label text="🏪" textFill="WHITE">
                            <font><Font size="28.0"/></font>
                        </Label>
                        <VBox alignment="CENTER_LEFT">
                            <children>
                                <Label styleClass="logo-text" text="Toko Kelontong"/>
                                <Label styleClass="logo-subtext" text="Admin Panel"/>
                            </children>
                        </VBox>
                    </children>
                    <padding><Insets left="20.0"/></padding>
                </HBox>

                <!-- Nav buttons -->
                <VBox spacing="5.0" styleClass="nav-menu" VBox.vgrow="ALWAYS">
                    <children>
                        <Button fx:id="btnDashboard" alignment="BASELINE_LEFT" mnemonicParsing="false"
                                prefHeight="45.0" prefWidth="250.0" styleClass="nav-btn-active"
                                text="Dashboard" onAction="#showDashboardView">
                            <padding><Insets left="30.0"/></padding>
                        </Button>
                        <Button fx:id="btnProduk" alignment="BASELINE_LEFT" mnemonicParsing="false"
                                prefHeight="45.0" prefWidth="250.0" styleClass="nav-btn"
                                text="Produk" onAction="#showProdukView">
                            <padding><Insets left="30.0"/></padding>
                        </Button>
                        <Button fx:id="btnStok" alignment="BASELINE_LEFT" mnemonicParsing="false"
                                prefHeight="45.0" prefWidth="250.0" styleClass="nav-btn"
                                text="Stok" onAction="#showStokView">
                            <padding><Insets left="30.0"/></padding>
                        </Button>
                        <Button fx:id="btnMember" alignment="BASELINE_LEFT" mnemonicParsing="false"
                                prefHeight="45.0" prefWidth="250.0" styleClass="nav-btn"
                                text="Member" onAction="#showMemberView">
                            <padding><Insets left="30.0"/></padding>
                        </Button>
                    </children>
                    <VBox.margin><Insets top="20.0"/></VBox.margin>
                </VBox>

                <!-- Logout + User -->
                <VBox>
                    <children>
                        <Button alignment="BASELINE_LEFT" mnemonicParsing="false"
                                prefHeight="45.0" prefWidth="250.0" styleClass="nav-btn"
                                text="Logout" onAction="#handleLogout">
                            <padding><Insets left="30.0"/></padding>
                        </Button>
                        <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="15.0" styleClass="user-profile">
                            <children>
                                <Circle fill="#e0e0e0" radius="20.0" stroke="TRANSPARENT" strokeType="INSIDE"/>
                                <VBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label fx:id="userNameLabel" styleClass="user-name" text="Admin"/>
                                        <Label styleClass="user-role" text="Admin"/>
                                    </children>
                                </VBox>
                            </children>
                            <padding><Insets left="20.0"/></padding>
                            <VBox.margin><Insets top="10.0"/></VBox.margin>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <!-- ===================== CENTER (StackPane multi-view) ===================== -->
    <center>
        <StackPane fx:id="contentArea" BorderPane.alignment="CENTER">
            <children>

                <!-- ========== DASHBOARD VIEW ========== -->
                <ScrollPane fx:id="dashboardView" fitToWidth="true" styleClass="main-scroll"
                            visible="true" managed="true">
                    <content>
                        <VBox prefWidth="900.0" spacing="20.0" styleClass="main-content-bg">
                            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="20.0"/></padding>
                            <children>

                                <HBox alignment="CENTER_LEFT" prefHeight="50.0">
                                    <children>
                                        <Label styleClass="header-title" text="☰   Admin Dashboard"/>
                                        <Label fx:id="welcomeLabel" styleClass="header-subtitle" text="Selamat datang!">
                                            <HBox.margin><Insets left="15.0"/></HBox.margin>
                                        </Label>
                                        <Pane HBox.hgrow="ALWAYS"/>
                                        <HBox alignment="CENTER_RIGHT" spacing="20.0">
                                            <children>
                                                <Label fx:id="dateLabel" styleClass="header-time" text=""/>
                                                <Label fx:id="timeLabel" styleClass="header-time" text=""/>
                                            </children>
                                        </HBox>
                                    </children>
                                </HBox>

                                <!-- Summary cards -->
                                <HBox spacing="20.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" prefHeight="100.0" spacing="15.0"
                                              styleClass="summary-card" HBox.hgrow="ALWAYS">
                                            <children>
                                                <StackPane prefHeight="60.0" prefWidth="60.0"
                                                           style="-fx-background-color: #22c55e; -fx-background-radius: 10;">
                                                    <children><Label text="📦" textFill="WHITE"><font><Font size="28.0"/></font></Label></children>
                                                </StackPane>
                                                <VBox alignment="CENTER_LEFT" spacing="5.0">
                                                    <children>
                                                        <Label styleClass="card-title" text="Total Produk"/>
                                                        <Label fx:id="cardTotalProduk" styleClass="card-value" text="0"/>
                                                        <Label styleClass="card-subtitle" text="Semua Produk"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                            <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0"/></padding>
                                        </HBox>

                                        <HBox alignment="CENTER_LEFT" prefHeight="100.0" spacing="15.0"
                                              styleClass="summary-card" HBox.hgrow="ALWAYS">
                                            <children>
                                                <StackPane prefHeight="60.0" prefWidth="60.0"
                                                           style="-fx-background-color: #f59e0b; -fx-background-radius: 10;">
                                                    <children><Label text="🧊" textFill="WHITE"><font><Font size="28.0"/></font></Label></children>
                                                </StackPane>
                                                <VBox alignment="CENTER_LEFT" spacing="5.0">
                                                    <children>
                                                        <Label styleClass="card-title" text="Total Stok"/>
                                                        <Label fx:id="cardTotalStok" styleClass="card-value" text="0"/>
                                                        <Label styleClass="card-subtitle" text="Semua Stok"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                            <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0"/></padding>
                                        </HBox>

                                        <HBox alignment="CENTER_LEFT" prefHeight="100.0" spacing="15.0"
                                              styleClass="summary-card" HBox.hgrow="ALWAYS">
                                            <children>
                                                <StackPane prefHeight="60.0" prefWidth="60.0"
                                                           style="-fx-background-color: #8b5cf6; -fx-background-radius: 10;">
                                                    <children><Label text="👥" textFill="WHITE"><font><Font size="28.0"/></font></Label></children>
                                                </StackPane>
                                                <VBox alignment="CENTER_LEFT" spacing="5.0">
                                                    <children>
                                                        <Label styleClass="card-title" text="Total Member"/>
                                                        <Label fx:id="cardTotalMember" styleClass="card-value" text="0"/>
                                                        <Label styleClass="card-subtitle" text="Semua Member"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                            <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0"/></padding>
                                        </HBox>

                                        <HBox alignment="CENTER_LEFT" prefHeight="100.0" spacing="15.0"
                                              styleClass="summary-card" HBox.hgrow="ALWAYS">
                                            <children>
                                                <StackPane prefHeight="60.0" prefWidth="60.0"
                                                           style="-fx-background-color: #ef4444; -fx-background-radius: 10;">
                                                    <children><Label text="⚠️" textFill="WHITE"><font><Font size="28.0"/></font></Label></children>
                                                </StackPane>
                                                <VBox alignment="CENTER_LEFT" spacing="5.0">
                                                    <children>
                                                        <Label styleClass="card-title" text="Stok Menipis"/>
                                                        <Label fx:id="cardStokMenipis" styleClass="card-value" text="0"/>
                                                        <Label styleClass="card-subtitle" text="Perlu Restock"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                            <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0"/></padding>
                                        </HBox>
                                    </children>
                                </HBox>

                                <!-- Stok menipis table -->
                                <VBox styleClass="content-box" VBox.vgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="section-title" text="Stok Produk Menipis"/>
                                                <Pane HBox.hgrow="ALWAYS"/>
                                                <Button styleClass="btn-link" text="Lihat Semua" onAction="#showStokView"/>
                                            </children>
                                            <VBox.margin><Insets bottom="15.0"/></VBox.margin>
                                        </HBox>
                                        <TableView fx:id="tableStokMenipis" prefHeight="250.0" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colStokNo" prefWidth="40.0" text="No"/>
                                                <TableColumn fx:id="colStokNama" prefWidth="200.0" text="Produk"/>
                                                <TableColumn fx:id="colStokJumlah" prefWidth="80.0" text="Stok"/>
                                                <TableColumn fx:id="colStokMin" prefWidth="100.0" text="Stok Min"/>
                                                <TableColumn fx:id="colStokSatuan" prefWidth="80.0" text="Satuan"/>
                                                <TableColumn fx:id="colStokStatus" prefWidth="100.0" text="Status"/>
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/></padding>
                                </VBox>

                            </children>
                        </VBox>
                    </content>
                </ScrollPane>

                <!-- ========== PRODUK VIEW ========== -->
                <VBox fx:id="produkView" visible="false" managed="false"
                      spacing="20.0" styleClass="main-content-bg">
                    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="20.0"/></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="50.0">
                            <children>
                                <Label styleClass="header-title" text="☰   Produk"/>
                                <Pane HBox.hgrow="ALWAYS"/>
                                <Button styleClass="btn-link" text="+ Tambah Produk" onAction="#handleTambahProduk"/>
                            </children>
                        </HBox>

                        <!-- Search bar -->
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <children>
                                <TextField fx:id="searchProdukField" promptText="Cari produk..."
                                           HBox.hgrow="ALWAYS"/>
                                <Button text="🔍 Cari" onAction="#handleSearchProduk"/>
                            </children>
                        </HBox>

                        <VBox styleClass="content-box" VBox.vgrow="ALWAYS">
                            <children>
                                <Label styleClass="section-title" text="Daftar Produk"/>
                                <TableView fx:id="tableProduk" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colProdukNo" prefWidth="40.0" text="No"/>
                                        <TableColumn fx:id="colProdukBarcode" prefWidth="120.0" text="Barcode"/>
                                        <TableColumn fx:id="colProdukNama" prefWidth="180.0" text="Nama Produk"/>
                                        <TableColumn fx:id="colProdukKategori" prefWidth="100.0" text="Kategori"/>
                                        <TableColumn fx:id="colProdukHarga" prefWidth="100.0" text="Harga"/>
                                        <TableColumn fx:id="colProdukStok" prefWidth="60.0" text="Stok"/>
                                        <TableColumn fx:id="colProdukSatuan" prefWidth="70.0" text="Satuan"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>

                                <!-- Pagination -->
                                <HBox alignment="CENTER" spacing="20.0">
                                    <padding><Insets top="10.0" bottom="10.0"/></padding>
                                    <children>
                                        <Button fx:id="btnPrevProduk" text="◀ Sebelumnya"
                                                styleClass="btn-link" onAction="#prevPageProduk" disable="true"/>
                                        <Label fx:id="lblPageProduk" text="Halaman 1 dari 1" styleClass="card-title"/>
                                        <Button fx:id="btnNextProduk" text="Selanjutnya ▶"
                                                styleClass="btn-link" onAction="#nextPageProduk"/>
                                    </children>
                                </HBox>

                                <!-- Action buttons -->
                                <HBox spacing="10.0">
                                    <children>
                                        <Button text="✏️ Edit Produk" styleClass="btn-link" onAction="#handleEditProduk"/>
                                        <Button text="🗑️ Hapus Produk" styleClass="btn-link" onAction="#handleHapusProduk"/>
                                    </children>
                                </HBox>
                            </children>
                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/></padding>
                        </VBox>
                    </children>
                </VBox>

                <!-- ========== STOK VIEW ========== -->
                <VBox fx:id="stokView" visible="false" managed="false"
                      spacing="20.0" styleClass="main-content-bg">
                    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="20.0"/></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="50.0">
                            <children>
                                <Label styleClass="header-title" text="☰   Stok"/>
                                <Pane HBox.hgrow="ALWAYS"/>
                                <Button styleClass="btn-link" text="+ Update Stok" onAction="#handleUpdateStok"/>
                            </children>
                        </HBox>

                        <VBox styleClass="content-box" VBox.vgrow="ALWAYS">
                            <children>
                                <Label styleClass="section-title" text="Data Stok Produk"/>
                                <TableView fx:id="tableStok" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colStokAllNo" prefWidth="40.0" text="No"/>
                                        <TableColumn fx:id="colStokAllNama" prefWidth="200.0" text="Produk"/>
                                        <TableColumn fx:id="colStokAllJumlah" prefWidth="80.0" text="Stok"/>
                                        <TableColumn fx:id="colStokAllMin" prefWidth="100.0" text="Stok Min"/>
                                        <TableColumn fx:id="colStokAllSatuan" prefWidth="80.0" text="Satuan"/>
                                        <TableColumn fx:id="colStokAllStatus" prefWidth="100.0" text="Status"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>
                                <HBox spacing="10.0">
                                    <padding><Insets top="10.0"/></padding>
                                    <children>
                                        <Button text="➕ Tambah Stok" styleClass="btn-link" onAction="#handleTambahStok"/>
                                        <Button text="➖ Kurangi Stok" styleClass="btn-link" onAction="#handleKurangiStok"/>
                                    </children>
                                </HBox>
                            </children>
                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/></padding>
                        </VBox>
                    </children>
                </VBox>

                <!-- ========== MEMBER VIEW ========== -->
                <VBox fx:id="memberView" visible="false" managed="false"
                      spacing="20.0" styleClass="main-content-bg">
                    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="20.0"/></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="50.0">
                            <children>
                                <Label styleClass="header-title" text="☰   Member"/>
                                <Pane HBox.hgrow="ALWAYS"/>
                                <Button styleClass="btn-link" text="+ Tambah Member" onAction="#handleTambahMember"/>
                            </children>
                        </HBox>

                        <!-- Search -->
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <children>
                                <TextField fx:id="searchMemberField" promptText="Cari member..."
                                           HBox.hgrow="ALWAYS"/>
                                <Button text="🔍 Cari" onAction="#handleSearchMember"/>
                            </children>
                        </HBox>

                        <VBox styleClass="content-box" VBox.vgrow="ALWAYS">
                            <children>
                                <Label styleClass="section-title" text="Daftar Member"/>
                                <TableView fx:id="tableMember" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colMemberNo" prefWidth="40.0" text="No"/>
                                        <TableColumn fx:id="colMemberKode" prefWidth="100.0" text="Kode"/>
                                        <TableColumn fx:id="colMemberNama" prefWidth="180.0" text="Nama"/>
                                        <TableColumn fx:id="colMemberTelp" prefWidth="120.0" text="No. Telepon"/>
                                        <TableColumn fx:id="colMemberPoin" prefWidth="80.0" text="Poin"/>
                                        <TableColumn fx:id="colMemberTotal" prefWidth="120.0" text="Total Belanja"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>
                                <HBox spacing="10.0">
                                    <padding><Insets top="10.0"/></padding>
                                    <children>
                                        <Button text="✏️ Edit Member" styleClass="btn-link" onAction="#handleEditMember"/>
                                        <Button text="🗑️ Hapus Member" styleClass="btn-link" onAction="#handleHapusMember"/>
                                    </children>
                                </HBox>
                            </children>
                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/></padding>
                        </VBox>
                    </children>
                </VBox>

                <!-- ========== LAPORAN VIEW ========== -->
                <VBox fx:id="laporanView" visible="false" managed="false"
                      spacing="20.0" styleClass="main-content-bg">
                    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="20.0"/></padding>
                    <children>
                        <Label styleClass="header-title" text="☰   Laporan"/>
                        <VBox styleClass="content-box" VBox.vgrow="ALWAYS">
                            <children>
                                <Label styleClass="section-title" text="Laporan Penjualan"/>
                                <Label text="Konten laporan akan ditampilkan di sini."
                                       style="-fx-text-fill: gray;"/>
                            </children>
                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/></padding>
                        </VBox>
                    </children>
                </VBox>

            </children>
        </StackPane>
    </center>
</BorderPane>

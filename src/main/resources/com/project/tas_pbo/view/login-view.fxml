<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import java.net.URL?>
<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.project.tas_pbo.controller.LoginController"
           styleClass="root-pane" prefWidth="1000" prefHeight="640">

    <stylesheets>
        <URL value="@../css/login.css" />
    </stylesheets>

    <!-- Background image (bound to rootPane size in controller) -->
    <ImageView fx:id="bgImage" preserveRatio="false" opacity="0">
<!--        <image>-->
<!--            <Image url="@/com/project/tas_pbo/image/Background_Login.png" />-->
<!--        </image>-->
    </ImageView>

    <!-- Outer card -->
    <HBox styleClass="card" maxWidth="900" maxHeight="560" prefWidth="900" prefHeight="560">

        <!-- LEFT: Brand / clock panel -->
        <VBox styleClass="brand-panel" prefWidth="340" minWidth="340">
            <padding>
                <Insets top="32" right="32" bottom="32" left="32" />
            </padding>

            <!-- Logo + name -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <StackPane styleClass="logo-box">
                    <Region styleClass="logo-icon" />
                </StackPane>
                <Label text="Toko Kelontong" styleClass="brand-name" />
            </HBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Date / time -->
            <Label fx:id="timeLabel" text="10:42 AM" styleClass="time-label" />
            <Label fx:id="dateLabel" text="Friday, June 12" styleClass="date-label" />

            <Region prefHeight="24" />

            <!-- Decorative status bar -->
            <HBox styleClass="status-bar" alignment="CENTER_RIGHT">
                <Region HBox.hgrow="ALWAYS" styleClass="status-segment" />
                <Region HBox.hgrow="ALWAYS" styleClass="status-segment status-divider" />
                <Region HBox.hgrow="ALWAYS" styleClass="status-segment status-divider" />
                <Region HBox.hgrow="ALWAYS" styleClass="status-segment status-divider" />
                <StackPane styleClass="status-segment status-divider" HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT">
                    <Region styleClass="status-dot" />
                </StackPane>
            </HBox>
        </VBox>

        <!-- RIGHT: Login form panel -->
        <VBox styleClass="form-panel" prefWidth="660" alignment="TOP_LEFT">
            <padding>
                <Insets top="48" right="56" bottom="48" left="56" />
            </padding>

            <Label text="Welcome back" styleClass="welcome-title" />
            <Label text="Sign in to start your shift" styleClass="welcome-subtitle" />

            <Region prefHeight="28" />

            <!-- Username -->
            <Label text="Username" styleClass="field-label" />
            <Region prefHeight="6" />
            <HBox styleClass="input-box" alignment="CENTER_LEFT" spacing="10">
                <Region styleClass="input-icon icon-user" />
                <TextField fx:id="txtUsername" promptText="Username"
                           styleClass="input-field" HBox.hgrow="ALWAYS" />
            </HBox>

            <Region prefHeight="18" />

            <!-- Password -->
            <Label text="Password" styleClass="field-label" />
            <Region prefHeight="6" />
            <HBox styleClass="input-box" alignment="CENTER_LEFT" spacing="10">
                <Region styleClass="input-icon icon-lock" />
                <StackPane HBox.hgrow="ALWAYS">
                    <PasswordField fx:id="txtPassword" promptText="••••••••"
                                   styleClass="input-field" />
                    <TextField fx:id="txtPasswordVisible" promptText="Password"
                               styleClass="input-field" visible="false" />
                </StackPane>
            </HBox>

            <Region prefHeight="8" />
            <CheckBox fx:id="chkShowPassword" text="Tampilkan Password" onAction="#handleShowPassword"
                      styleClass="show-password-checkbox" />

            <Region prefHeight="14" />

            <!-- Alert label -->
            <Label fx:id="loginTextAlert" text="" styleClass="alert-label" wrapText="true" />

            <Region prefHeight="14" />

            <!-- Sign in button -->
            <Button text="Sign in" styleClass="signin-button"
                    maxWidth="Infinity" onAction="#handleLogin" />

        </VBox>

    </HBox>

</StackPane>
